@AccessControl.authorizationCheck: #MANDATORY
@Metadata.allowExtensions: true
@ObjectModel.sapObjectNodeType.name: 'ZTICKET_ITEM_03'
@EndUserText.label: '###GENERATED Core Data Service Entity'
define root view entity ZR_TICKET_ITEM_03000
  as select from ZTICKET_ITEM_03
  association [0..1] to ZI_NVD_TICKET_READ_SCOPE as _ReadScope
    on $projection.TicketID = _ReadScope.TicketID
  composition [0..*] of ZR_NVD_TKT_ATT as _Attachments
  composition [0..*] of ZR_NVD_COMMENT as _Comments
  composition [0..*] of ZR_NVD_INTERNAL_NOTE as _InternalNotes
  association [0..*] to ZI_NVD_TKT_HIST as _History on $projection.TicketID = _History.TicketID
  association [0..1] to ZI_TICKET_PRIO_VH_03 as _Priority on $projection.Priority = _Priority.Priority
  association [0..1] to ZI_TICKET_STATUS_VH_03 as _Status on $projection.Status = _Status.Status
  association [0..1] to ZI_TICKET_CATEG_VH_03 as _Category on $projection.Category = _Category.Category
{
  key ticket_id as TicketID,
  subject as Subject,
  requester_id as RequesterID,
  assigned_to as AssignedTo,
  requester_user as RequesterUser,
  assigned_agent_user as AssignedAgentUser,
  support_team_id as SupportTeamID,
  migration_status as MigrationStatus,
  priority as Priority,
  status as Status,
  category as Category,
  description as Description,
  due_date as DueDate,
  @Semantics.user.createdBy: true
  created_by as CreatedBy,
  @Semantics.systemDateTime.createdAt: true
  created_at as CreatedAt,
  @Semantics.user.localInstanceLastChangedBy: true
  last_changed_by as LastChangedBy,
  @Semantics.systemDateTime.localInstanceLastChangedAt: true
  local_last_changed_at as LocalLastChangedAt,
  @Semantics.systemDateTime.lastChangedAt: true
  last_changed_at as LastChangedAt,
  _ReadScope,
  _Attachments,
  _Comments,
  _InternalNotes,
  _History,
  _Priority,
  _Status,
  _Category
}
