@EndUserText.label : 'Geschütztes Audit interner Notizen'
@AbapCatalog.enhancement.category : #NOT_EXTENSIBLE
@AbapCatalog.tableCategory : #TRANSPARENT
@AbapCatalog.deliveryClass : #A
@AbapCatalog.dataMaintenance : #RESTRICTED
define table znvd_note_audit {

  key client     : abap.clnt not null;
  key event_uuid : abap.raw(16) not null;
  ticket_id      : abap.numc(8) not null;
  note_uuid      : abap.raw(16) not null;
  change_uuid    : abap.raw(16) not null;
  event_type     : abap.char(32) not null;
  changed_by     : abp_creation_user not null;
  changed_at     : abp_creation_tstmpl not null;

}
