projection implementation in class ZBP_C_TICKET_ITEM_03 unique;
strict ( 2 );
extensible;
use draft;
use side effects;
define behavior for ZC_TICKET_ITEM_03 alias ZcTicketItem03
extensible
use etag
{
  use create;
  use update;
  use delete;
  use action startWork;
  use action markResolved;
  use action reopenTicket;
  use action closeTicket;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Attachments { create; with draft; }

}

define behavior for ZC_NVD_TKT_ATT alias ZcNvdTicketAttachment
use etag
{
  use update;
  use delete;

  use association _Ticket { with draft; }
}